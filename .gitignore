# Runtime logs, local databases and backups. Flyway SQL migrations remain tracked.
*.log
*.pid
*.db
*.sqlite
*.sqlite3
*.sqlite3-*
*.dump
*.sql.gz
*.sql.zip
/backups/

# Keep browser verification scripts; exclude generated screenshots, frames and logs.
/artifacts/*
!/artifacts/frontend/
/artifacts/frontend/*
!/artifacts/frontend/verify_*.py
