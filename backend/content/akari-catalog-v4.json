  "levels": [
    {
      "level_id": "akari-v2-tutorial",
      "game_id": "akari",
      "level_version": 2,
      "rules_version": 2,
      "reward_policy_version": 1,
      "order": 1,
      "number": 0,
      "name": "入门",
      "difficulty": "tutorial",
      "focus": "七步认识照明规则",
      "guide": "点击白格放灯，再点一次撤灯。灯光沿横竖传播，遇到黑墙停止。",
      "minimum_level": 1,
      "prerequisite_level_id": null,
      "modes": [
        "campaign"
      ],
      "max_stars": 1,
      "star_xp": [
        2
      ],
      "t3_ms": 64000,
      "t2_ms": 128000,
      "puzzle": {
        "rows": 5,
        "cols": 5,
        "map": [
          "..0#1",
          ".###.",
          "0####",
          "##10#",
          "##..#"
        ],
        "tutorial": true,
        "tutorial_steps": [
          {
            "title": "点亮第一束光",
            "text": "点击高亮格放灯。灯光沿横竖传播，不会穿过黑墙；暖黄色表示已照亮。",
            "index": 0,
            "bulb": true,
            "focus": [
              0,
              1,
              5
            ]
          },
          {
            "title": "放错也能修改",
            "text": "再次点击同一盏灯，把它撤下。任何未通关的棋盘都可以这样修改。",
            "index": 0,
            "bulb": false,
            "focus": [
              0
            ]
          },
          {
            "title": "观察光线与黑墙",
            "text": "再放回这盏灯。右侧和下方的黑墙挡住光线，黑墙本身不能放灯。",
            "index": 0,
            "bulb": true,
            "focus": [
              0,
              2,
              10
            ]
          },
          {
            "title": "体验灯泡互照",
            "text": "点击高亮格再放一盏灯，观察两盏灯互相照射时出现的红色提示。",
            "index": 1,
            "bulb": true,
            "focus": [
              0,
              1
            ]
          },
          {
            "title": "消除互照冲突",
            "text": "撤下刚才新增的灯，消除红色冲突。两束光可以交叉，但灯泡不能照到另一盏灯。",
            "index": 1,
            "bulb": false,
            "focus": [
              0,
              1
            ]
          },
          {
            "title": "读懂数字墙",
            "text": "0的上下左右不能放灯；1～4要求相邻灯数恰好等于数字，斜角不算。点击高亮格，让右上角的1恰好邻接一盏灯。",
            "index": 9,
            "bulb": true,
            "focus": [
              2,
              4,
              9,
              10
            ]
          },
          {
            "title": "独立点亮最后一区",
            "text": "照亮剩余白格，并同时满足所有数字、灯泡不互照。已照亮的格子仍可点击；只有三个条件全部满足才通关。",
            "focus": [
              17,
              18,
              22,
              23
            ]
          }
        ],
        "checksum": "7c498c5f142251db5491367dfac0ec2db60cdbe8247a4ecc3c24c537878deb01"
      }
