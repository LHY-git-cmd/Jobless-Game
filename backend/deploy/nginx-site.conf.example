# 作用：合并到项目域名的 HTTPS server {}，先替换路径；保留宝塔原有证书配置。
root /www/wwwroot/jobless-game/frontend;
index index.html;

# 显式前缀优先于宝塔常见的js/css正则缓存，避免更新后继续缓存旧模块12小时。
location ^~ /src/ {
    expires off;
    add_header Cache-Control no-cache always;
    try_files $uri =404;
}
location ^~ /styles/ {
    expires off;
    add_header Cache-Control no-cache always;
    try_files $uri =404;
}

location / {
    add_header Cache-Control no-cache always;
    try_files $uri $uri/ =404;
}

# 素材沿用七天缓存；页面、模块与样式通过上方规则每次验证。
location /assets/ {
    expires 7d;
    try_files $uri =404;
}

# API location 共用同一代理配置，Origin 和 Cookie 始终使用站点同源地址。
location = /api/auth/login {
    limit_req zone=jobless_login burst=5 nodelay;
    limit_req_status 429;
    client_max_body_size 4k;
    client_body_timeout 10s;
    error_page 429 = @jobless_login_busy;
    include /www/wwwroot/jobless-game/backend/deploy/nginx-proxy.conf;
}

# 论坛额度独立，不扩大登录、头像或挑战接口的体积上限。
location /api/forum/ {
    client_max_body_size 32k;
    client_body_timeout 10s;
    include /www/wwwroot/jobless-game/backend/deploy/nginx-proxy.conf;
}

# SSE长响应独立配置；不扩大其他API的超时或请求体上限。
location = /api/v1/me/events {
    proxy_pass http://127.0.0.1:8001;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_send_timeout 10s;
    proxy_read_timeout 75s;
    proxy_buffering off;
    proxy_cache off;
}

location /api/ {
    client_max_body_size 4k;
    include /www/wwwroot/jobless-game/backend/deploy/nginx-proxy.conf;
}

location @jobless_login_busy {
    default_type application/json;
    add_header Retry-After 60 always;
    add_header Cache-Control no-store always;
    return 429 '{"detail":"登录请求过于频繁，请稍后重试。"}';
}

# 拒绝读取源码和配置；root 只指向 frontend，后端与 .env 不在 Web 根目录。
location ~ /\. {
    deny all;
}
