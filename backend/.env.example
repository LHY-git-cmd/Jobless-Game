# 复制为 .env 后填写项目数据库连接；示例不含真实凭据。
DATABASE_URL=mysql+pymysql://app_user:change-me@127.0.0.1:3306/jobless_game?charset=utf8mb4
SESSION_COOKIE_NAME=jobless_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=3
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
LOGIN_HASH_CONCURRENCY=1
MAX_REQUEST_BODY_BYTES=4096
# 同账号主题间隔与评论/回复共用间隔；幂等重试不重复限频。
FORUM_POST_INTERVAL_SECONDS=60
FORUM_COMMENT_INTERVAL_SECONDS=3
# 临时开发验收：只在专用开发数据库启用，上线保持 false，后续可移除。
DEV_QUICK_COMPLETE_ENABLED=false
# 正式成长独立开关：先完成V5～V9迁移，生产PK仍需目标机容量验收。
PROGRESSION_ENABLED=false
COSMETICS_ENABLED=false
PK_ROOMS_ENABLED=false
MATCHMAKING_ENABLED=false
PK_ROOM_LIMIT=4
PK_TICKET_LIMIT=8
PK_SSE_LIMIT=16

